{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mission Control Live CRM",
  "type": "object",
  "required": ["pipeline"],
  "properties": {
    "pipeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stage", "count", "value"],
        "properties": {
          "stage": { "type": "string" },
          "count": { "type": "number", "minimum": 0 },
          "value": { "type": "number", "minimum": 0 }
        }
      }
    },
    "nextActionsToday": { "type": "array" },
    "topOpportunities": { "type": "array" }
  }
}
