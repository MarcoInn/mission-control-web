{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mission Control Live Tasks",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "titel", "status", "prioritaet", "owner"],
    "properties": {
      "id": { "type": "string" },
      "titel": { "type": "string" },
      "status": { "enum": ["todo", "in_progress", "review", "blocked", "done", "cancelled"] },
      "prioritaet": { "enum": ["kritisch", "hoch", "mittel", "niedrig"] },
      "owner": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } } },
      "due_date": { "type": ["string", "null"] },
      "updated_at": { "type": ["string", "null"] },
      "blocker": {
        "type": "object",
        "properties": {
          "ist_blockiert": { "type": "boolean" },
          "due_time": { "type": ["string", "null"] },
          "next_action": { "type": ["string", "null"] }
        }
      }
    }
  }
}
